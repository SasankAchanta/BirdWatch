{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "allowJs": true,
    "noEmit": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.js",
    "**/*.jsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
, "app/Profile.jsx", "app/Inventory.js", "app/Camera.jsx", "app/NavBar.jsx", "app/index.jsx", "app/index.jsx", "app/_layout.jsx"  ]
}
